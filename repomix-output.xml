                </div>
                <div style={{ display: 'inline-block', width: '45%', verticalAlign: 'top', marginTop: '60px' }}>
                    <div style={{ borderTop: '1px solid black', width: '80%', margin: '0 auto', paddingTop: '5px' }}>
                        <strong>NOTARIO / SECRETARIO(A)</strong><br />
                        DOY FE
                    </div>
                </div>
