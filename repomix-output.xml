          return actual ? `${actual.nombre} ${actual.apellido || ''}`.trim().toUpperCase() : 'PÁRROCO ENCARGADO';
      };

      return {
          id: raw.id || generateUUID(),
          parishId: pId,
          tipoIdentidad: identityId,
          Libro: String(raw.Libro || '0').padStart(4, '0'),
          folio: String(raw.folio || '0').padStart(4, '0'),
