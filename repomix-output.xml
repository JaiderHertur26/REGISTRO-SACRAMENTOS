          {/* ================== TAB BAUTIZOS ================== */}
          <TabsContent value="bautizos" className="space-y-8 animate-in fade-in duration-500">

            {/* SECCIÓN 1: DATOS DEL DECRETO */}
            <div className="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
