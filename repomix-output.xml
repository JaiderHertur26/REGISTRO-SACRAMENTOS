<file path="src/pages/BaptismListPage.jsx">
import React, { useState } from 'react';
import { Helmet } from 'react-helmet';
import { motion } from 'framer-motion';
import { Link } from 'react-router-dom';
import { useAppData } from '@/context/AppDataContext';
import DashboardLayout from '@/components/DashboardLayout';
import { Button } from '@/components/ui/button';
import { Search, Eye, Filter } from 'lucide-react';

const BaptismListPage = () => {
  const { data } = useAppData();
  const [searchTerm, setSearchTerm] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');

  const filteredBaptisms = data.baptisms.filter(baptism => {
    const matchesSearch = 
      `${baptism.firstName} ${baptism.lastName}`.toLowerCase().includes(searchTerm.toLowerCase()) ||
      baptism.parish?.toLowerCase().includes(searchTerm.toLowerCase());
    
    const matchesStatus = statusFilter === 'all' || baptism.status === statusFilter;
    
    return matchesSearch && matchesStatus;
  });

  return (
    <>
      <Helmet>
        <title>{'Baptism Records'}</title>
        <meta name="description" content="View and manage all baptism records" />
      </Helmet>

      <DashboardLayout>
        <div className="max-w-7xl mx-auto">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <div className="mb-6">
              <h1 className="text-3xl font-bold text-gray-900">Baptism Records</h1>
              <p className="text-gray-600 mt-1">View and manage all baptisms</p>
            </div>

            {/* Filters */}
            <div className="bg-white rounded-xl shadow-lg p-4 mb-6">
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div className="md:col-span-2">
                  <div className="relative">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
                    <input
                      type="text"
                      placeholder="Search by name or parish..."
                      value={searchTerm}
                      onChange={(e) => setSearchTerm(e.target.value)}
                      className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-gray-900"
                    />
                  </div>
                </div>

                <div>
                  <select
                    value={statusFilter}
                    onChange={(e) => setStatusFilter(e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-gray-900"
                  >
                    <option value="all">All Status</option>
                    <option value="pending">Pending</option>
                    <option value="seated">Seated</option>
                  </select>
                </div>
              </div>
            </div>

            {/* Results */}
            <div className="bg-white rounded-xl shadow-lg overflow-hidden">
              {filteredBaptisms.length === 0 ? (
                <div className="p-12 text-center">
                  <p className="text-gray-500 text-lg">No baptism records found</p>
                  <p className="text-gray-400 text-sm mt-2">Try adjusting your search or filters</p>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead className="bg-gray-50 border-b border-gray-200">
                      <tr>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Baptized Name
                        </th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Baptism Date
                        </th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Parish
                        </th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Status
                        </th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Actions
                        </th>
                      </tr>
                    </thead>
                    <tbody className="bg-white divide-y divide-gray-200">
                      {filteredBaptisms.map((baptism) => (
                        <tr key={baptism.id} className="hover:bg-gray-50 transition-colors">
                          <td className="px-6 py-4 whitespace-nowrap">
                            <div className="text-sm font-medium text-gray-900">
                              {baptism.firstName} {baptism.lastName}
                            </div>
                          </td>
                          <td className="px-6 py-4 whitespace-nowrap">
                            <div className="text-sm text-gray-900">
                              {new Date(baptism.baptismDate).toLocaleDateString()}
                            </div>
                          </td>
                          <td className="px-6 py-4 whitespace-nowrap">
                            <div className="text-sm text-gray-900">{baptism.parish}</div>
                          </td>
                          <td className="px-6 py-4 whitespace-nowrap">
                            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${
                              baptism.status === 'seated'
                                ? 'bg-green-100 text-green-800'
                                : 'bg-yellow-100 text-yellow-800'
                            }`}>
                              {baptism.status === 'seated' ? 'Seated' : 'Pending'}
                            </span>
                          </td>
                          <td className="px-6 py-4 whitespace-nowrap text-sm">
                            <Link to={`/baptism/${baptism.id}`}>
                              <Button variant="outline" size="sm" className="gap-2">
                                <Eye className="w-4 h-4" />
                                View
                              </Button>
                            </Link>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </motion.div>
        </div>
      </DashboardLayout>
    </>
  );
};

export default BaptismListPage;
</file>

<file path="src/pages/CelebratedBaptismForm.jsx">
import React, { useState } from 'react';
import { Helmet } from 'react-helmet';
import { motion } from 'framer-motion';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '@/context/AuthContext';
import { useAppData } from '@/context/AppDataContext';
import DashboardLayout from '@/components/DashboardLayout';
import { Button } from '@/components/ui/button';
import { useToast } from '@/components/ui/use-toast';
import { ArrowLeft, Save, Printer } from 'lucide-react';

const CelebratedBaptismForm = () => {
  const { user } = useAuth();
  const { data, addBaptism } = useAppData();
  const navigate = useNavigate();
  const { toast } = useToast();

  const [formData, setFormData] = useState({
    baptismDate: '',
    baptismTime: '',
    parish: user?.parishName || '',
    celebrantMinister: '',
    firstName: '',
    lastName: '',
    sex: '',
    birthDate: '',
    birthCity: '',
    birthMunicipality: '',
    birthDepartment: '',
    birthCountry: '',
    document: '',
    fatherName: '',
    motherName: '',
    parentsMaritalStatus: '',
    parentsAddress: '',
    parentsPhone: '',
    parentsEmail: '',
    godfatherName: '',
    godmotherName: '',
    observations: '',
    registeringUser: user?.username || '',
    bookNumber: '',
    folioNumber: '',
    baptismNumber: '',
    status: 'seated'
  });

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    if (!formData.bookNumber || !formData.folioNumber || !formData.baptismNumber) {
      toast({
        title: "Validation Error",
        description: "Book, Folio, and Baptism numbers are required for seated baptisms.",
        variant: "destructive",
      });
      return;
    }
    
    addBaptism(formData);

    toast({
      title: "Baptism Registered",
      description: "The baptism has been saved with seated status in the official registry.",
    });

    const shouldPrint = window.confirm('Baptism registered successfully! Would you like to print the certificate now?');
    
    if (shouldPrint) {
      const baptisms = JSON.parse(localStorage.getItem('baptisms') || '[]');
      const savedBaptism = baptisms[baptisms.length - 1];
      navigate(`/baptism/print/${savedBaptism.id}`);
    } else {
      navigate('/baptism/list');
    }
  };

  return (
    <>
      <Helmet>
        <title>{'Already Celebrated Baptism'}</title>
        <meta name="description" content="Register an already celebrated baptism" />
      </Helmet>

      <DashboardLayout>
        <div className="max-w-4xl mx-auto">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <div className="flex items-center gap-4 mb-6">
              <Button
                variant="outline"
                size="sm"
                onClick={() => navigate('/dashboard')}
                className="gap-2"
              >
                <ArrowLeft className="w-4 h-4" />
                Back
              </Button>
              <div>
                <h1 className="text-3xl font-bold text-gray-900">Already Celebrated Baptism</h1>
                <p className="text-gray-600 mt-1">Register baptism with seated status</p>
              </div>
            </div>

            <form onSubmit={handleSubmit} className="bg-white rounded-xl shadow-lg p-6 space-y-6">
              {/* Registry Numbers */}
              <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <h2 className="text-lg font-semibold text-gray-900 mb-4">Official Registry Numbers *</h2>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Book Number *
                    </label>
                    <input
                      type="text"
                      name="bookNumber"
                      value={formData.bookNumber}
                      onChange={handleChange}
                      required
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-gray-900"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Folio Number *
                    </label>
                    <input
                      type="text"
                      name="folioNumber"
                      value={formData.folioNumber}
                      onChange={handleChange}
                      required
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-gray-900"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Baptism Number *
                    </label>
                    <input
                      type="text"
                      name="baptismNumber"
                      value={formData.baptismNumber}
                      onChange={handleChange}
                      required
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-gray-900"
