                                value={formData.nombre} 
                                onChange={e => setFormData({...formData, nombre: e.target.value.toUpperCase()})} 
                                className="py-6 font-black uppercase text-gray-800 border-gray-200 focus:ring-[#4B7BA7]/10"
                                placeholder="EJ: BARRANQUILLA"
