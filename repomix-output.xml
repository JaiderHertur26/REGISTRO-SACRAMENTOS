                        <span className="text-xs text-gray-700">Formato: {`{ "data": [...] }`}</span>
                    </label>
                </div>
            )}
            {loading && <div className="text-center text-gray-900 font-medium py-4">Procesando archivo...</div>}

            {validationResult && (
                <div className="space-y-4">
