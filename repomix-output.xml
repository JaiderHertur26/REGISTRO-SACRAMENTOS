      {/* --- BLOQUE SUPERIOR --- */}
      <div className="w-full flex-1 flex flex-col">
          
          {/* ENCABEZADO OFICIAL */}
          <div className="text-center mb-3 relative border-b border-black pb-2 shrink-0">
