            ministerFaith: prev.ministerFaith || getSafeValue(found, 'ministerFaith', 'dafe', 'daFe'),
          }));
        }
      } else {
        setMarSearchMessage({ type: 'error', text: "No se encontró ninguna partida con esos datos." });
      }
      setIsLoading(false);
    }, 300);
  };

  return (
