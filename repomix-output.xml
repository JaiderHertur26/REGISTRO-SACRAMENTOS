    if (!item.nro_decreto) errors.push("Falta número de decreto");
    if (!item.fec_decreto) errors.push("Falta fecha de decreto");
    
    // Sacrament specific checks if needed
    // ...

    return {
        isValid: errors.length === 0,
        errors
    };
